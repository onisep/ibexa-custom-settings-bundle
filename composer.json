{
    "name": "onisep/ibexa-custom-settings-bundle",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Onisep\\IbexaCustomSettingsBundle\\": "src/"
        }
    },
    "authors": [
        {
            "name": "Florian Bouché",
            "email": "florian.bouche@onisep.fr"
        }
    ],
    "require": {
        "php": ">=8.3",
        "symfony/framework-bundle": "^7.3",
        "ibexa/core": "^5.0",
        "ibexa/admin-ui": "^5.0",
        "guzzlehttp/promises": "^2.3",
        "nyholm/psr7": "^1.8"
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true
        }
    }
}
